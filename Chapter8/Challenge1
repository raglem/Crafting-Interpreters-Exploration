class True {
    ifThen(thenBranch) {
        return thenBranch();
    }
    ifThenElse(thenBranch, elseBranch) {
        return thenBranch();
    }
}
class False {
    ifThen(thenBranch) {
        return nil;
    }
    ifThenElse(thenBranch, elseBranch) {
        return elseBranch();
    }
}

var trueInstance = True();
var falseInstance = False();

fun goodFunction() {
    print "good";
}
fun badFunction() {
    print "bad";
}

// Only "good" should print
trueInstance.ifThen(goodFunction);
trueInstance.ifThenElse(goodFunction, badFunction);

falseInstance.ifThen(badFunction);
falseInstance.ifThenElse(badFunction, goodFunction);